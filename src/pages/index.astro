---
import FaqItem from "../components/FaqItem.astro";
import PhoneShot from "../components/PhoneShot.astro";
import Layout from "../layouts/Layout.astro";
import {
  appCard,
  appCardAlt,
  apps,
  badge,
  badgeAlt,
  benefit,
  benefits,
  btnGhost,
  btnOnDark,
  btnPrimary,
  h2,
  hero,
  heroCta,
  heroGrid,
  heroTitle,
  kicker,
  kickerLight,
  lead,
  phones,
  section,
  sectionCta,
  sectionNavy,
  sectionSoft,
  step,
  stepNum,
  steps,
  sub,
  subOnNavy,
  wrap,
} from "../lib/ui";
---

<Layout page="home">
  <section class={hero}>
    <div class={`${wrap} ${heroGrid}`}>
      <div>
        <h1 class={heroTitle} data-aos="fade-up" data-i18n="hero.title">Find your deal!</h1>
        <p class={lead} data-aos="fade-up" data-i18n="hero.lead">
          UNEMDE is a mobile marketplace for local café and restaurant deals. Guests find a venue on the map, book a
          slot, and redeem on-site. Venues manage offers and scan QR codes in UNEMDE Business.
        </p>
        <div class={heroCta} data-aos="fade-up">
          <a class={btnGhost} href="/guest" data-i18n="hero.ctaGuest">I’m a guest</a>
          <a class={btnOnDark} href="/venue" data-i18n="hero.ctaBiz">I’m a venue</a>
        </div>
      </div>
      <div class={phones} aria-hidden="true">
        <PhoneShot src="/imgs/unemde/u-mainpage-l.jpg" motion="a" aos="fade-right" />
        <PhoneShot src="/imgs/unemde-business/ub-scanner-l.jpg" motion="b" aos="fade-left" delay={120} />
      </div>
    </div>
  </section>

  <section class={section}>
    <div class={wrap}>
      <p class={kicker} data-aos="fade-up" data-i18n="how.kicker">How it works</p>
      <h2 class={h2} data-aos="fade-up" data-i18n="how.title">Four steps from deal to table</h2>
      <p class={sub} data-aos="fade-up" data-i18n="how.sub">
        One flow for guests and venues: find an offer, book a time, activate on-site, and get the discount.
      </p>
      <div class={steps}>
        <article class={step} data-aos="fade-up">
          <div class={stepNum}>1</div>
          <h3 class="mt-4 text-lg" data-i18n="how.s1t">Discover</h3>
          <p class="mt-2 text-sm leading-5 text-dark-gray" data-i18n="how.s1p"></p>
        </article>
        <article class={step} data-aos="fade-up" data-aos-delay="80">
          <div class={stepNum}>2</div>
          <h3 class="mt-4 text-lg" data-i18n="how.s2t">Book</h3>
          <p class="mt-2 text-sm leading-5 text-dark-gray" data-i18n="how.s2p"></p>
        </article>
        <article class={step} data-aos="fade-up" data-aos-delay="160">
          <div class={stepNum}>3</div>
          <h3 class="mt-4 text-lg" data-i18n="how.s3t">Activate</h3>
          <p class="mt-2 text-sm leading-5 text-dark-gray" data-i18n="how.s3p"></p>
        </article>
        <article class={step} data-aos="fade-up" data-aos-delay="240">
          <div class={stepNum}>4</div>
          <h3 class="mt-4 text-lg" data-i18n="how.s4t">Enjoy</h3>
          <p class="mt-2 text-sm leading-5 text-dark-gray" data-i18n="how.s4p"></p>
        </article>
      </div>
    </div>
  </section>

  <section class={sectionSoft}>
    <div class={wrap}>
      <p class={kicker} data-aos="fade-up" data-i18n="home.chooseKicker">Choose a role</p>
      <h2 class={h2} data-aos="fade-up" data-i18n="home.chooseTitle">Guest or venue?</h2>
      <p class={sub} data-aos="fade-up" data-i18n="home.chooseSub">Two apps — one local-deals service.</p>
      <div class={apps}>
        <article class={appCard} data-aos="fade-up">
          <div class="mb-[18px] grid grid-cols-2 gap-2.5">
            <img
              class="aspect-9/16 w-full rounded-[14px] border border-border object-cover object-top"
              src="/imgs/unemde/u-loadscreen.jpg"
              alt=""
            />
            <img
              class="aspect-9/16 w-full rounded-[14px] border border-border object-cover object-top"
              src="/imgs/unemde/u-mainpage-d.jpg"
              alt=""
            />
          </div>
          <span class={badge}>UNEMDE</span>
          <h3 class="mt-2 text-2xl" data-i18n="apps.gTitle">For guests</h3>
          <p class="mt-2.5 text-[15px] text-dark-gray" data-i18n="apps.gText"></p>
          <a class={`${btnPrimary} mt-6`} href="/guest" data-i18n="home.more">Learn more</a>
        </article>
        <article class={appCardAlt} data-aos="fade-up" data-aos-delay="120">
          <div class="mb-[18px] grid grid-cols-2 gap-2.5">
            <img
              class="aspect-9/16 w-full rounded-[14px] border border-white/16 object-cover object-top"
              src="/imgs/unemde-business/ub-loadscreen.jpg"
              alt=""
            />
            <img
              class="aspect-9/16 w-full rounded-[14px] border border-white/16 object-cover object-top"
              src="/imgs/unemde-business/ub-scanner-d.jpg"
              alt=""
            />
          </div>
          <span class={badgeAlt}>UNEMDE Business</span>
          <h3 class="mt-2 text-2xl" data-i18n="apps.bTitle">For venues</h3>
          <p class="mt-2.5 text-[15px] text-white/78" data-i18n="apps.bText"></p>
          <a class={`${btnGhost} mt-6`} href="/venue" data-i18n="home.more">Learn more</a>
        </article>
      </div>
    </div>
  </section>

  <section class={sectionNavy}>
    <div class={wrap}>
      <p class={kickerLight} data-aos="fade-up" data-i18n="partner.kicker">Become a Partner</p>
      <h2 class={h2} data-aos="fade-up" data-i18n="partner.title">Grow your business with UNEMDE</h2>
      <p class={subOnNavy} data-aos="fade-up" data-i18n="partner.sub"></p>
      <div class={benefits}>
        <article class={benefit} data-aos="fade-up">
          <h3 class="text-base" data-i18n="partner.v1t"></h3>
          <p class="mt-2 text-sm text-dark-gray" data-i18n="partner.v1p"></p>
        </article>
        <article class={benefit} data-aos="fade-up" data-aos-delay="80">
          <h3 class="text-base" data-i18n="partner.v2t"></h3>
          <p class="mt-2 text-sm text-dark-gray" data-i18n="partner.v2p"></p>
        </article>
        <article class={benefit} data-aos="fade-up" data-aos-delay="160">
          <h3 class="text-base" data-i18n="partner.v3t"></h3>
          <p class="mt-2 text-sm text-dark-gray" data-i18n="partner.v3p"></p>
        </article>
        <article class={benefit} data-aos="fade-up" data-aos-delay="240">
          <h3 class="text-base" data-i18n="partner.v4t"></h3>
          <p class="mt-2 text-sm text-dark-gray" data-i18n="partner.v4p"></p>
        </article>
      </div>
      <div class={sectionCta} data-aos="fade-up">
        <a class={btnOnDark} href="/partner" data-i18n="home.partnerCta">Become a partner</a>
      </div>
    </div>
  </section>

  <section class={section}>
    <div class={`${wrap} max-w-[760px]`}>
      <p class={kicker} data-aos="fade-up" data-i18n="home.faqKicker">FAQ</p>
      <h2 class={h2} data-aos="fade-up" data-i18n="home.faqTitle">Top questions</h2>
      <div data-aos="fade-up">
        <FaqItem q="faq.q1" a="faq.a1" open />
        <FaqItem q="faq.q4" a="faq.a4" />
        <FaqItem q="faq.q11" a="faq.a11" />
      </div>
      <div class={sectionCta} data-aos="fade-up">
        <a class={btnPrimary} href="/faq" data-i18n="home.faqAll">All questions</a>
      </div>
    </div>
  </section>
</Layout>
