---
import GuestJourney from "../components/guest/GuestJourney.astro";
import StoreBadges from "../components/guest/StoreBadges.astro";
import PhoneShot from "../components/shared/PhoneShot.astro";
import Layout from "../layouts/Layout.astro";
import {
  check,
  checkList,
  checkRow,
  h2Flush,
  hero,
  heroTitle,
  leadWide,
  pageHeroGrid,
  phonesSolo,
  sectionJourney,
  subMuted,
  wrapCenter,
} from "../lib/ui";
---

<Layout page="guest">
  <section class={hero}>
    <div class={pageHeroGrid}>
      <div>
        <h1 class={heroTitle} data-i18n="guest.title">Local deals you can actually use.</h1>
        <p class={leadWide} data-i18n="guest.sub">
          Not a coupon catalogue for later. Each offer is tied to a time and place: book, arrive, activate.
        </p>
        <ul class={checkList}>
          <li class={checkRow}>
            <span class={check}>✓</span>
            <span data-i18n="guest.b1">Current</span>
          </li>
          <li class={checkRow}>
            <span class={check}>✓</span>
            <span data-i18n="guest.b2">Nearby</span>
          </li>
          <li class={checkRow}>
            <span class={check}>✓</span>
            <span data-i18n="guest.b3">Convenient</span>
          </li>
        </ul>
      </div>
      <div class={phonesSolo} aria-hidden="true">
        <PhoneShot src="/imgs/unemde/u-loadscreen.jpg" motion="solo" />
      </div>
    </div>
  </section>

  <section class={sectionJourney}>
    <div class={wrapCenter}>
      <h2 class={h2Flush} data-i18n="guest.journeyTitle">How to use</h2>
      <p class={subMuted} data-i18n="guest.journeySub">
        Every screen a guest uses — from the first launch to the places they come back to.
      </p>
    </div>
    <GuestJourney />
  </section>

  <section class="pt-6 pb-10" id="download">
    <div class={wrapCenter}>
      <h2 class={h2Flush} data-i18n="guest.storeTitle">Get the app</h2>
      <StoreBadges />
    </div>
  </section>
</Layout>
