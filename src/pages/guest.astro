---
import PhoneShot from "../components/PhoneShot.astro";
import Layout from "../layouts/Layout.astro";
import {
  btnOnDark,
  btnPrimary,
  check,
  checkList,
  feature,
  featureGrid,
  featureList,
  h2,
  iconBox,
  kicker,
  kickerLight,
  lead,
  pageHero,
  pageHeroTitle,
  phonesInline,
  section,
  sectionCta,
  sectionSoft,
  shotCard,
  shotRow,
  split,
  wrap,
} from "../lib/ui";
---

<Layout page="guest">
  <section class={pageHero}>
    <div class={wrap}>
      <p class={kickerLight} data-i18n="guest.kicker">UNEMDE for guests</p>
      <h1 class={pageHeroTitle} data-i18n="guest.title">Local deals you can actually use</h1>
      <p class={lead} data-i18n="guest.sub"></p>
      <a class={`${btnOnDark} mt-6`} href="#stores" data-i18n="apps.gCta">UNEMDE for iOS & Android</a>
    </div>
  </section>

  <section class={section}>
    <div class={`${wrap} ${split}`}>
      <div data-aos="fade-right">
        <p class={kicker} data-i18n="how.kicker">How it works</p>
        <h2 class={h2} data-i18n="how.title"></h2>
        <div class={featureList}>
          <div class={feature}>
            <div class={iconBox}>1</div>
            <div>
              <h3 class="text-base" data-i18n="how.s1t"></h3>
              <p class="mt-0.5 text-sm text-dark-gray" data-i18n="how.s1p"></p>
            </div>
          </div>
          <div class={feature}>
            <div class={iconBox}>2</div>
            <div>
              <h3 class="text-base" data-i18n="how.s2t"></h3>
              <p class="mt-0.5 text-sm text-dark-gray" data-i18n="how.s2p"></p>
            </div>
          </div>
          <div class={feature}>
            <div class={iconBox}>3</div>
            <div>
              <h3 class="text-base" data-i18n="how.s3t"></h3>
              <p class="mt-0.5 text-sm text-dark-gray" data-i18n="how.s3p"></p>
            </div>
          </div>
          <div class={feature}>
            <div class={iconBox}>4</div>
            <div>
              <h3 class="text-base" data-i18n="how.s4t"></h3>
              <p class="mt-0.5 text-sm text-dark-gray" data-i18n="how.s4p"></p>
            </div>
          </div>
        </div>
      </div>
      <div class={phonesInline} aria-hidden="true">
        <PhoneShot src="/imgs/unemde/u-mydeals-l.jpg" motion="a" />
        <PhoneShot src="/imgs/unemde/u-restaurantpage-l.jpg" motion="b" delay={140} />
      </div>
    </div>
  </section>

  <section class={sectionSoft}>
    <div class={wrap}>
      <div class={`${featureList} ${featureGrid}`}>
        <div class={feature} data-aos="fade-up">
          <div class={iconBox}>📍</div>
          <div>
            <h3 class="text-base" data-i18n="guest.f1t"></h3>
            <p class="mt-0.5 text-sm text-dark-gray" data-i18n="guest.f1p"></p>
          </div>
        </div>
        <div class={feature} data-aos="fade-up" data-aos-delay="80">
          <div class={iconBox}>🔖</div>
          <div>
            <h3 class="text-base" data-i18n="guest.f2t"></h3>
            <p class="mt-0.5 text-sm text-dark-gray" data-i18n="guest.f2p"></p>
          </div>
        </div>
        <div class={feature} data-aos="fade-up" data-aos-delay="160">
          <div class={iconBox}>♡</div>
          <div>
            <h3 class="text-base" data-i18n="guest.f3t"></h3>
            <p class="mt-0.5 text-sm text-dark-gray" data-i18n="guest.f3p"></p>
          </div>
        </div>
      </div>
      <div class={shotRow}>
        <figure class={shotCard} data-aos="zoom-in">
          <img class="aspect-9/16 w-full object-cover object-top" src="/imgs/unemde/u-mainpage-l.jpg" alt="" />
          <figcaption class="px-3 pt-2.5 pb-3.5 text-center text-[13px] font-bold" data-i18n="shots.discover">
            Discover
          </figcaption>
        </figure>
        <figure class={shotCard} data-aos="zoom-in" data-aos-delay="80">
          <img class="aspect-9/16 w-full object-cover object-top" src="/imgs/unemde/u-restaurantpage-l.jpg" alt="" />
          <figcaption class="px-3 pt-2.5 pb-3.5 text-center text-[13px] font-bold" data-i18n="shots.venue"></figcaption>
        </figure>
        <figure class={shotCard} data-aos="zoom-in" data-aos-delay="160">
          <img class="aspect-9/16 w-full object-cover object-top" src="/imgs/unemde/u-mydeals-l.jpg" alt="" />
          <figcaption class="px-3 pt-2.5 pb-3.5 text-center text-[13px] font-bold" data-i18n="shots.deals"></figcaption>
        </figure>
        <figure class={shotCard} data-aos="zoom-in" data-aos-delay="240">
          <img class="aspect-9/16 w-full object-cover object-top" src="/imgs/unemde/u-rating-l.jpg" alt="" />
          <figcaption class="px-3 pt-2.5 pb-3.5 text-center text-[13px] font-bold" data-i18n="how.h6t">Enjoy</figcaption>
        </figure>
      </div>
      <ul class={checkList} data-aos="fade-up">
        <li class="flex items-start gap-2.5"><span class={check}>✓</span> <span data-i18n="apps.g1"></span></li>
        <li class="flex items-start gap-2.5"><span class={check}>✓</span> <span data-i18n="apps.g2"></span></li>
        <li class="flex items-start gap-2.5"><span class={check}>✓</span> <span data-i18n="apps.g3"></span></li>
      </ul>
      <div class={sectionCta}>
        <a class={btnPrimary} href="#stores" data-i18n="apps.gCta"></a>
      </div>
    </div>
  </section>
</Layout>
