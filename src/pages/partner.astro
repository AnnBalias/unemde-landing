---
import Layout from "../layouts/Layout.astro";
import {
  benefitBordered,
  benefits,
  btnPrimary,
  cities,
  city,
  field,
  h2,
  input,
  kicker,
  kickerLight,
  lead,
  pageHero,
  pageHeroTitle,
  partnerForm,
  partnerGrid,
  section,
  sectionSoft,
  stat,
  statsCompact,
  sub,
  wrap,
} from "../lib/ui";
---

<Layout page="partner">
  <section class={pageHero}>
    <div class={wrap}>
      <p class={kickerLight} data-i18n="partner.kicker">Become a Partner</p>
      <h1 class={pageHeroTitle} data-i18n="partner.title">Grow your business with UNEMDE</h1>
      <p class={lead} data-i18n="partner.sub"></p>
    </div>
  </section>

  <section class={section}>
    <div class={wrap}>
      <p class={kicker} data-i18n="partner.why"></p>
      <h2 class={h2} data-i18n="partner.whySub"></h2>
      <div class={benefits}>
        <article class={benefitBordered} data-aos="fade-up">
          <h3 class="text-base" data-i18n="partner.v1t"></h3>
          <p class="mt-2 text-sm text-dark-gray" data-i18n="partner.v1p"></p>
        </article>
        <article class={benefitBordered} data-aos="fade-up" data-aos-delay="80">
          <h3 class="text-base" data-i18n="partner.v2t"></h3>
          <p class="mt-2 text-sm text-dark-gray" data-i18n="partner.v2p"></p>
        </article>
        <article class={benefitBordered} data-aos="fade-up" data-aos-delay="160">
          <h3 class="text-base" data-i18n="partner.v3t"></h3>
          <p class="mt-2 text-sm text-dark-gray" data-i18n="partner.v3p"></p>
        </article>
        <article class={benefitBordered} data-aos="fade-up" data-aos-delay="240">
          <h3 class="text-base" data-i18n="partner.v4t"></h3>
          <p class="mt-2 text-sm text-dark-gray" data-i18n="partner.v4p"></p>
        </article>
      </div>
    </div>
  </section>

  <section class={sectionSoft}>
    <div class={wrap}>
      <p class={kicker} data-i18n="partner.reach"></p>
      <h2 class={h2} data-i18n="partner.reachSub"></h2>
      <div class={cities} data-aos="fade-up">
        <div class={city}><b class="block text-[28px] text-blue-dark">142</b><span class="text-sm font-semibold text-dark-gray">Praha</span></div>
        <div class={city}><b class="block text-[28px] text-blue-dark">87</b><span class="text-sm font-semibold text-dark-gray">Brno</span></div>
        <div class={city}><b class="block text-[28px] text-blue-dark">45</b><span class="text-sm font-semibold text-dark-gray">Ostrava</span></div>
        <div class={city}><b class="block text-[28px] text-blue-dark">63</b><span class="text-sm font-semibold text-dark-gray">Bratislava</span></div>
        <div class={city}><b class="block text-[28px] text-blue-dark">31</b><span class="text-sm font-semibold text-dark-gray">Plzeň</span></div>
      </div>
    </div>
  </section>

  <section class={section}>
    <div class={`${wrap} ${partnerGrid}`}>
      <div data-aos="fade-right">
        <h2 class={h2} data-i18n="partner.formTitle"></h2>
        <p class={sub} data-i18n="partner.formSub"></p>
        <div class={statsCompact}>
          <div class={stat}>
            <b class="block text-[28px] text-blue-dark" data-i18n="partner.s1n">368+</b>
            <span class="text-sm text-dark-gray" data-i18n="partner.s1t"></span>
          </div>
          <div class={stat}>
            <b class="block text-[28px] text-blue-dark" data-i18n="partner.s2n">50k+</b>
            <span class="text-sm text-dark-gray" data-i18n="partner.s2t"></span>
          </div>
          <div class={stat}>
            <b class="block text-[28px] text-blue-dark" data-i18n="partner.s3n">4.8★</b>
            <span class="text-sm text-dark-gray" data-i18n="partner.s3t"></span>
          </div>
        </div>
      </div>
      <form class={partnerForm} id="partnerForm" data-aos="fade-left">
        <label class={field}><span data-i18n="partner.name"></span><input class={input} name="name" type="text" required /></label>
        <label class={field}><span data-i18n="partner.email"></span><input class={input} name="email" type="email" required /></label>
        <label class={field}><span data-i18n="partner.phone"></span><input class={input} name="phone" type="tel" /></label>
        <label class={field}>
          <span data-i18n="partner.category"></span>
          <select class={input} name="category" required>
            <option value="" data-i18n="partner.catPlaceholder"></option>
            <option value="partnership" data-i18n="partner.catPartnership"></option>
            <option value="support" data-i18n="partner.catSupport"></option>
            <option value="press" data-i18n="partner.catPress"></option>
            <option value="other" data-i18n="partner.catOther"></option>
          </select>
        </label>
        <label class={field}>
          <span data-i18n="partner.message"></span>
          <textarea class={`${input} min-h-24 resize-y`} name="message" rows="4" required></textarea>
        </label>
        <label class={field}><span data-i18n="partner.date"></span><input class={input} name="date" type="date" /></label>
        <label class="flex items-center gap-2.5 text-[13px] font-medium">
          <input class="size-[18px] min-h-[18px] shadow-none" name="terms" type="checkbox" required />
          <span data-i18n="partner.terms"></span>
        </label>
        <button class={btnPrimary} type="submit" data-i18n="partner.send"></button>
        <p class="text-sm font-semibold text-green-dark" id="partnerOk" hidden data-i18n="partner.success"></p>
      </form>
    </div>
  </section>
</Layout>
