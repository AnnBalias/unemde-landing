---
import PhoneShot from "../components/PhoneShot.astro";
import Layout from "../layouts/Layout.astro";
import {
  btnGhost,
  btnOnDark,
  check,
  checkList,
  feature,
  featureList,
  iconBox,
  kickerLight,
  lead,
  pageHero,
  pageHeroCta,
  pageHeroTitle,
  phonesInline,
  section,
  sectionSoft,
  shotCard,
  shotRow,
  split,
  stat,
  stats,
  wrap,
} from "../lib/ui";
---

<Layout page="venue">
  <section class={pageHero}>
    <div class={wrap}>
      <p class={kickerLight} data-i18n="biz.kicker">UNEMDE Business</p>
      <h1 class={pageHeroTitle} data-i18n="biz.title">Counter, calendar, and deals in one venue app</h1>
      <p class={lead} data-i18n="biz.sub"></p>
      <div class={pageHeroCta}>
        <a class={btnOnDark} href="#stores" data-i18n="apps.bCta">UNEMDE Business</a>
        <a class={btnGhost} href="/partner" data-i18n="home.partnerCta">Become a partner</a>
      </div>
    </div>
  </section>

  <section class={section}>
    <div class={`${wrap} ${split}`}>
      <div data-aos="fade-right">
        <div class={featureList}>
          <div class={feature}>
            <div class={iconBox}>✎</div>
            <div>
              <h3 class="text-base" data-i18n="biz.f1t"></h3>
              <p class="mt-0.5 text-sm text-dark-gray" data-i18n="biz.f1p"></p>
            </div>
          </div>
          <div class={feature}>
            <div class={iconBox}>▣</div>
            <div>
              <h3 class="text-base" data-i18n="biz.f2t"></h3>
              <p class="mt-0.5 text-sm text-dark-gray" data-i18n="biz.f2p"></p>
            </div>
          </div>
          <div class={feature}>
            <div class={iconBox}>▦</div>
            <div>
              <h3 class="text-base" data-i18n="biz.f3t"></h3>
              <p class="mt-0.5 text-sm text-dark-gray" data-i18n="biz.f3p"></p>
            </div>
          </div>
        </div>
      </div>
      <div class={phonesInline} aria-hidden="true">
        <PhoneShot src="/imgs/unemde-business/ub-restaurantdetails-l.jpg" motion="a" />
        <PhoneShot src="/imgs/unemde-business/ub-bookingcalendar-l.jpg" motion="b" delay={140} />
      </div>
    </div>
  </section>

  <section class={sectionSoft}>
    <div class={wrap}>
      <div class={shotRow}>
        <figure class={shotCard} data-aos="zoom-in">
          <img class="aspect-9/16 w-full object-cover object-top" src="/imgs/unemde-business/ub-scanner-l.jpg" alt="" />
          <figcaption class="px-3 pt-2.5 pb-3.5 text-center text-[13px] font-bold" data-i18n="shots.scanner"></figcaption>
        </figure>
        <figure class={shotCard} data-aos="zoom-in" data-aos-delay="80">
          <img
            class="aspect-9/16 w-full object-cover object-top"
            src="/imgs/unemde-business/ub-restaurantdetails-l.jpg"
            alt=""
          />
          <figcaption class="px-3 pt-2.5 pb-3.5 text-center text-[13px] font-bold" data-i18n="shots.edit"></figcaption>
        </figure>
        <figure class={shotCard} data-aos="zoom-in" data-aos-delay="160">
          <img
            class="aspect-9/16 w-full object-cover object-top"
            src="/imgs/unemde-business/ub-bookingcalendar-l.jpg"
            alt=""
          />
          <figcaption class="px-3 pt-2.5 pb-3.5 text-center text-[13px] font-bold" data-i18n="shots.calendar"></figcaption>
        </figure>
        <figure class={shotCard} data-aos="zoom-in" data-aos-delay="240">
          <img class="aspect-9/16 w-full object-cover object-top" src="/imgs/unemde-business/ub-loadscreen.jpg" alt="" />
          <figcaption class="px-3 pt-2.5 pb-3.5 text-center text-[13px] font-bold">UNEMDE Business</figcaption>
        </figure>
      </div>
      <div class={stats}>
        <div class={stat} data-aos="fade-up">
          <b class="block text-[28px] text-blue-dark">QR</b>
          <span class="text-sm text-dark-gray" data-i18n="biz.st1"></span>
        </div>
        <div class={stat} data-aos="fade-up" data-aos-delay="80">
          <b class="block text-[28px] text-blue-dark">1+1</b>
          <span class="text-sm text-dark-gray" data-i18n="biz.st2"></span>
        </div>
        <div class={stat} data-aos="fade-up" data-aos-delay="160">
          <b class="block text-[28px] text-blue-dark">CZK</b>
          <span class="text-sm text-dark-gray" data-i18n="biz.st3"></span>
        </div>
      </div>
      <ul class={checkList} data-aos="fade-up">
        <li class="flex items-start gap-2.5"><span class={check}>✓</span> <span data-i18n="apps.b1"></span></li>
        <li class="flex items-start gap-2.5"><span class={check}>✓</span> <span data-i18n="apps.b2"></span></li>
        <li class="flex items-start gap-2.5"><span class={check}>✓</span> <span data-i18n="apps.b3"></span></li>
      </ul>
    </div>
  </section>
</Layout>
