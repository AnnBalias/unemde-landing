---
import PartnerSection from "../components/PartnerSection.astro";
import PhoneShot from "../components/PhoneShot.astro";
import VenueJourney from "../components/VenueJourney.astro";
import Layout from "../layouts/Layout.astro";
import { btnGhost, check, h2, hero, heroCta, heroTitle, lead, phones, wrap } from "../lib/ui";
---

<Layout page="venue">
  <section class={hero}>
    <div
      class={`${wrap} relative grid grid-cols-1 items-start gap-8 nav:grid-cols-[minmax(0,1.55fr)_minmax(11rem,0.45fr)] nav:gap-4`}
    >
      <div>
        <h1 class={heroTitle} data-aos="fade-up" data-i18n="biz.title">
          Counter, calendar, and deals in one venue app
        </h1>
        <p class={`${lead} max-w-2xl`} data-aos="fade-up" data-i18n="biz.sub">
          Built for cafés, bakeries, and restaurants. Publish offers guests see in UNEMDE, then redeem them on-site with
          the scanner.
        </p>
        <ul class="mt-6 grid gap-2.5 text-[15px] font-medium" data-aos="fade-up">
          <li class="flex items-center gap-2.5">
            <span class={check}>✓</span>
            <span data-i18n="biz.b1">Scanner</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class={check}>✓</span>
            <span data-i18n="biz.b2">Calendar</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class={check}>✓</span>
            <span data-i18n="biz.b3">Storefront</span>
          </li>
        </ul>
        <div class={heroCta} data-aos="fade-up">
          <a class={btnGhost} href="#partner-form" data-i18n="home.partnerCta">Become a partner</a>
        </div>
      </div>
      <div class={`${phones} max-nav:mx-auto nav:ml-auto nav:mr-0`} aria-hidden="true">
        <PhoneShot src="/imgs/unemde-business/ub-loadscreen.jpg" motion="solo" aos="fade-left" />
      </div>
    </div>
  </section>

  <section class="overflow-visible pt-10 pb-0">
    <div class={`${wrap} text-center`}>
      <h2 class={`${h2} mt-0`} data-aos="fade-up" data-i18n="biz.journeyTitle">How to use</h2>
      <p class="mt-3 text-base text-dark-gray" data-aos="fade-up" data-i18n="biz.journeySub">
        Every screen a venue uses — from sign-in to scanning a guest at the counter.
      </p>
    </div>
    <VenueJourney />
  </section>

  <PartnerSection />
</Layout>
