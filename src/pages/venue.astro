---
import PhoneShot from "../components/shared/PhoneShot.astro";
import PartnerSection from "../components/venue/PartnerSection.astro";
import VenueJourney from "../components/venue/VenueJourney.astro";
import Layout from "../layouts/Layout.astro";
import {
  btnGhost,
  check,
  checkList,
  checkRow,
  h2Flush,
  hero,
  heroCta,
  heroTitle,
  leadWide,
  pageHeroGrid,
  phonesSolo,
  sectionJourney,
  subMuted,
  wrapCenter,
} from "../lib/ui";
---

<Layout page="venue">
  <section class={hero}>
    <div class={pageHeroGrid}>
      <div>
        <h1 class={heroTitle} data-i18n="biz.title">
          Counter, calendar, and deals in one venue app
        </h1>
        <p class={leadWide} data-i18n="biz.sub">
          Built for cafés, bakeries, and restaurants. Publish offers guests see in UNEMDE, then redeem them on-site with
          the scanner.
        </p>
        <ul class={checkList}>
          <li class={checkRow}>
            <span class={check}>✓</span>
            <span data-i18n="biz.b1">Scanner</span>
          </li>
          <li class={checkRow}>
            <span class={check}>✓</span>
            <span data-i18n="biz.b2">Calendar</span>
          </li>
          <li class={checkRow}>
            <span class={check}>✓</span>
            <span data-i18n="biz.b3">Storefront</span>
          </li>
        </ul>
        <div class={heroCta}>
          <a class={btnGhost} href="#partner-contact" data-i18n="home.partnerCta">Become a partner</a>
        </div>
      </div>
      <div class={phonesSolo} aria-hidden="true">
        <PhoneShot src="/imgs/unemde-business/ub-loadscreen.jpg" motion="solo" />
      </div>
    </div>
  </section>

  <section class={sectionJourney}>
    <div class={wrapCenter}>
      <h2 class={h2Flush} data-i18n="biz.journeyTitle">How to use</h2>
      <p class={subMuted} data-i18n="biz.journeySub">
        Every screen a venue uses — from sign-in to scanning a guest at the counter.
      </p>
    </div>
    <VenueJourney />
  </section>

  <PartnerSection />
</Layout>
