---
import { REACH_CITIES, REACH_H, REACH_LABELS, REACH_PATHS, REACH_W } from "../data/reach-map";

const pinH = 48;
const pinFont = 22;
const tipH = 46;
const tipFont = 22;
const tipGap = 10;

const pinWidth = (n: string) => Math.max(pinH, Math.round(n.length * pinFont * 0.62 + 26));
const tipWidth = (name: string) => Math.max(88, Math.round(name.length * tipFont * 0.62 + 36));
---

<div class="h-full min-h-[240px]" data-aos="fade-up" data-reach-map>
  <div class="relative h-full min-h-[240px] overflow-hidden rounded-[20px] bg-[#d9e4f4] shadow-card">
    <div class="relative h-full min-h-[240px] w-full max-nav:aspect-[1100/620]">
      <svg
        class="absolute inset-0 h-full w-full font-sans"
        viewBox={`0 0 ${REACH_W} ${REACH_H}`}
        preserveAspectRatio="xMidYMid meet"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Partner cities in Czechia and Slovakia"
      >
        <defs>
          <linearGradient id="reachFill" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#456bb9"></stop>
            <stop offset="1" stop-color="#1f3053"></stop>
          </linearGradient>
          <linearGradient id="pinGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#004515"></stop>
            <stop offset="1" stop-color="#359752"></stop>
          </linearGradient>
          <filter id="pinShadow" x="-30%" y="-40%" width="160%" height="180%">
            <feDropShadow dx="0" dy="2" stdDeviation="3.5" flood-color="rgb(6 51 54)" flood-opacity="0.18"
            ></feDropShadow>
          </filter>
        </defs>

        <g aria-hidden="true">
          <path
            fill="url(#reachFill)"
            stroke="#fff"
            stroke-linejoin="round"
            stroke-width="2.25"
            d={REACH_PATHS.czechia}></path>
          <path
            fill="url(#reachFill)"
            stroke="#fff"
            stroke-linejoin="round"
            stroke-width="2.25"
            d={REACH_PATHS.slovakia}></path>
          <text
            x={REACH_LABELS.cz.x}
            y={REACH_LABELS.cz.y}
            text-anchor="middle"
            fill="rgb(255 255 255 / 0.75)"
            font-size="16"
            font-weight="700"
            letter-spacing="1.4"
            style="text-transform: uppercase"
            data-i18n="partner.countryCz">Czechia</text
          >
          <text
            x={REACH_LABELS.sk.x}
            y={REACH_LABELS.sk.y}
            text-anchor="middle"
            fill="rgb(255 255 255 / 0.75)"
            font-size="16"
            font-weight="700"
            letter-spacing="1.4"
            style="text-transform: uppercase"
            data-i18n="partner.countrySk">Slovakia</text
          >
        </g>

        {
          REACH_CITIES.map((city) => {
            const w = pinWidth(city.n);
            const tw = tipWidth(city.name);
            const tipTop = -pinH / 2 - tipGap - tipH;
            const tipBottom = tipTop + tipH;
            return (
              <g transform={`translate(${city.x} ${city.y})`}>
                <g
                  class="reach-pin"
                  data-reach-pin
                  data-city={city.name}
                  data-count={city.n}
                  tabindex="0"
                  role="button"
                  aria-label={`${city.name}, ${city.n}`}
                >
                  <g class="reach-pin-tip">
                    <rect
                      x={-tw / 2}
                      y={tipTop}
                      width={tw}
                      height={tipH}
                      rx="12"
                      fill="#fff"
                      filter="url(#pinShadow)"></rect>
                    <path d={`M-7 ${tipBottom} L0 ${tipBottom + 8} L7 ${tipBottom} Z`} fill="#fff"></path>
                    <text
                      class="reach-pin-tip-text"
                      y={tipTop + tipH / 2 + 1}
                      text-anchor="middle"
                      dominant-baseline="middle"
                      fill="#1f3053"
                      font-size={tipFont}
                      font-weight="500"
                    >
                      {city.name}
                    </text>
                  </g>
                  <rect
                    class="reach-pin-btn"
                    x={-w / 2}
                    y={-pinH / 2}
                    width={w}
                    height={pinH}
                    rx={pinH / 2}
                    fill="url(#pinGrad)"
                    filter="url(#pinShadow)"></rect>
                  <text
                    class="reach-pin-num"
                    y="1.5"
                    text-anchor="middle"
                    dominant-baseline="middle"
                    fill="#fff"
                    font-size={pinFont}
                    font-weight="500"
                  >
                    {city.n}
                  </text>
                </g>
              </g>
            );
          })
        }
      </svg>
    </div>
  </div>
</div>

<style>
  :global([data-reach-map] .reach-pin) {
    cursor: pointer;
    outline: none;
    pointer-events: auto;
    transform-box: fill-box;
    transform-origin: center;
    -webkit-tap-highlight-color: transparent;
  }

  :global([data-reach-map] .reach-pin-num),
  :global([data-reach-map] .reach-pin-tip-text) {
    font-family: inherit;
    font-weight: 500;
  }

  :global([data-reach-map] .reach-pin-tip) {
    opacity: 0;
    pointer-events: none;
  }

  :global([data-reach-map] .reach-pin:is(:hover, :focus-visible, [data-open])) {
    transform: translateY(-2px);
  }

  :global([data-reach-map] .reach-pin:is(:hover, :focus-visible, [data-open]) .reach-pin-tip) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-reach-map] .reach-pin-tip) {
      transition: opacity 0.15s ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-reach-map] .reach-pin:is(:hover, :focus-visible, [data-open])) {
      transform: none;
    }
  }
</style>
