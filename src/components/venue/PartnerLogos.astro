---
const logos = Array.from({ length: 8 }, (_, i) => i);
---

<div
  class="partner-marquee mt-8 w-full overflow-hidden"
  aria-label="UNEMDE"
>
  <div class="partner-marquee-track flex w-max items-center">
    {
      [0, 1].map((copy) => (
        <ul
          class="m-0 flex list-none items-center gap-16 p-0 pr-16 sm:gap-20 sm:pr-20"
          aria-hidden={copy === 1 ? "true" : undefined}
        >
          {logos.map(() => (
            <li class="flex shrink-0 items-center gap-2.5">
              <span class="grid size-10 place-items-center overflow-hidden rounded-[10px] bg-brand">
                <img class="size-full object-cover" src="/icon.png" alt="" />
              </span>
              <span class="text-[22px] font-bold tracking-[-0.03em] text-blue-dark">UNEMDE</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .partner-marquee {
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .partner-marquee-track {
    animation: partner-marquee 32s linear infinite;
  }

  .partner-marquee:hover .partner-marquee-track {
    animation-play-state: paused;
  }

  @keyframes partner-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-marquee-track {
      animation: none;
    }
  }
</style>
