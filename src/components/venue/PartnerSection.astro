---
import { TELEGRAM_URL, WHATSAPP_URL } from "../../data/contacts";
import PartnerLogos from "./PartnerLogos.astro";
import {
  benefitGlass,
  benefits,
  btnGreen,
  btnPrimary,
  h2,
  sectionBrand,
  subOnNavy,
  wrap,
  wrapPad,
} from "../../lib/ui";

const stats = [
  { n: "partner.s1n", t: "partner.s1t", fallbackN: "368+", fallbackT: "Active partner locations across the region" },
  { n: "partner.s2n", t: "partner.s2t", fallbackN: "50k+", fallbackT: "Monthly active users discovering deals" },
] as const;
---

<section class="scroll-mt-[76px] overflow-visible pb-16" id="partner">
  <div class={sectionBrand}>
    <div class={wrapPad}>
      <h2 class={`${h2} mt-0`} data-i18n="partner.title">Grow your business with UNEMDE</h2>
      <p class={subOnNavy} data-i18n="partner.sub">
        Join local businesses already reaching new customers every day through our platform.
      </p>
      <div class={benefits}>
        <article class={benefitGlass} data-aos="fade-up">
          <h3 class="text-base font-medium" data-i18n="partner.v1t">More visibility</h3>
          <p class="mt-2 text-sm text-white/72" data-i18n="partner.v1p"></p>
        </article>
        <article class={benefitGlass} data-aos="fade-up" data-aos-delay="80">
          <h3 class="text-base font-medium" data-i18n="partner.v2t">Real analytics</h3>
          <p class="mt-2 text-sm text-white/72" data-i18n="partner.v2p"></p>
        </article>
        <article class={benefitGlass} data-aos="fade-up" data-aos-delay="160">
          <h3 class="text-base font-medium" data-i18n="partner.v3t">Free to start</h3>
          <p class="mt-2 text-sm text-white/72" data-i18n="partner.v3p"></p>
        </article>
        <article class={benefitGlass} data-aos="fade-up" data-aos-delay="240">
          <h3 class="text-base font-medium" data-i18n="partner.v4t">Dedicated support</h3>
          <p class="mt-2 text-sm text-white/72" data-i18n="partner.v4p"></p>
        </article>
      </div>
    </div>
  </div>

  <div class="pt-4">
    <div class={`${wrap} text-center`}>
      <h2 class={`${h2} mt-0`} data-i18n="partner.reach">Our partners</h2>
      <p class="mt-3 text-base text-dark-gray" data-i18n="partner.reachSub">
        Local venues already growing with UNEMDE.
      </p>
    </div>
    <PartnerLogos />
    <div class={`${wrap} mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2`}>
      {
        stats.map((item) => (
          <div class="overflow-hidden rounded-[20px] border border-border bg-white p-7 shadow-card">
            <b class="block text-[28px] text-blue-dark" data-i18n={item.n}>
              {item.fallbackN}
            </b>
            <span class="mt-2 block text-sm text-dark-gray" data-i18n={item.t}>
              {item.fallbackT}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div class={`${wrap} mt-10 scroll-mt-[76px]`} id="partner-contact">
    <div class="text-center">
      <h2 class={`${h2} mt-0`} data-i18n="partner.contactTitle">Ready to join? Let’s talk.</h2>
      <p class="mt-3 text-base text-dark-gray" data-i18n="partner.contactSub">
        Write to us on WhatsApp or Telegram — our partnership team replies within 24 hours.
      </p>
    </div>
    <div class="mx-auto mt-8 flex w-full max-w-[520px] flex-col gap-3 sm:flex-row">
      <a
        class={`${btnGreen} flex-1`}
        href={WHATSAPP_URL}
        target="_blank"
        rel="noreferrer"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path></svg
        >
        <span data-i18n="partner.whatsapp">WhatsApp</span>
      </a>
      <a
        class={`${btnPrimary} flex-1`}
        href={TELEGRAM_URL}
        target="_blank"
        rel="noreferrer"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"
          ><path
            d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
          ></path></svg
        >
        <span data-i18n="partner.telegram">Telegram</span>
      </a>
    </div>
  </div>
</section>
