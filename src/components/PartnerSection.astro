---
import ReachMap from "./ReachMap.astro";
import {
  benefitGlass,
  benefits,
  btnPrimary,
  field,
  h2,
  input,
  partnerForm,
  sectionBrand,
  subOnNavy,
  wrap,
  wrapPad,
} from "../lib/ui";

const stats = [
  { n: "partner.s1n", t: "partner.s1t", fallbackN: "368+", fallbackT: "Active partner locations across the region" },
  { n: "partner.s2n", t: "partner.s2t", fallbackN: "50k+", fallbackT: "Monthly active users discovering deals" },
  { n: "partner.s3n", t: "partner.s3t", fallbackN: "4.8★", fallbackT: "Average partner satisfaction rating" },
] as const;
---

<section class="scroll-mt-[76px] overflow-visible pb-16" id="partner">
  <div class={sectionBrand}>
    <div class={wrapPad}>
      <h2 class={`${h2} mt-0`} data-aos="fade-up" data-i18n="partner.title">Grow your business with UNEMDE</h2>
      <p class={subOnNavy} data-aos="fade-up" data-i18n="partner.sub">
        Join local businesses already reaching new customers every day through our platform.
      </p>
      <div class={benefits}>
        <article class={benefitGlass} data-aos="fade-up">
          <h3 class="text-base font-medium" data-i18n="partner.v1t">More visibility</h3>
          <p class="mt-2 text-sm text-white/72" data-i18n="partner.v1p"></p>
        </article>
        <article class={benefitGlass} data-aos="fade-up" data-aos-delay="80">
          <h3 class="text-base font-medium" data-i18n="partner.v2t">Real analytics</h3>
          <p class="mt-2 text-sm text-white/72" data-i18n="partner.v2p"></p>
        </article>
        <article class={benefitGlass} data-aos="fade-up" data-aos-delay="160">
          <h3 class="text-base font-medium" data-i18n="partner.v3t">Free to start</h3>
          <p class="mt-2 text-sm text-white/72" data-i18n="partner.v3p"></p>
        </article>
        <article class={benefitGlass} data-aos="fade-up" data-aos-delay="240">
          <h3 class="text-base font-medium" data-i18n="partner.v4t">Dedicated support</h3>
          <p class="mt-2 text-sm text-white/72" data-i18n="partner.v4p"></p>
        </article>
      </div>
    </div>
  </div>

  <div class={`${wrap} pt-4`}>
    <div class="text-center">
      <h2 class={`${h2} mt-0`} data-aos="fade-up" data-i18n="partner.reach">Our partners</h2>
      <p class="mt-3 text-base text-dark-gray" data-aos="fade-up" data-i18n="partner.reachSub">
        See where UNEMDE partners are active — click the dots!
      </p>
    </div>
    <div class="mt-8 grid grid-cols-1 items-stretch gap-5 nav:grid-cols-[minmax(15.5rem,0.36fr)_minmax(0,1fr)]">
      <div class="grid gap-5">
        {
          stats.map((item, i) => (
            <div
              class="overflow-hidden rounded-[20px] border border-border bg-white p-7 shadow-card"
              data-aos="fade-up"
              data-aos-delay={i * 80}
            >
              <b class="block text-[28px] text-blue-dark" data-i18n={item.n}>
                {item.fallbackN}
              </b>
              <span class="mt-2 block text-sm text-dark-gray" data-i18n={item.t}>
                {item.fallbackT}
              </span>
            </div>
          ))
        }
      </div>
      <ReachMap />
    </div>
  </div>

  <div class={`${wrap} mt-10 scroll-mt-[76px]`} id="partner-form">
    <div class="text-center">
      <h2 class={`${h2} mt-0`} data-aos="fade-up" data-i18n="partner.formTitle">Ready to join? Let’s talk.</h2>
      <p class="mt-3 text-base text-dark-gray" data-aos="fade-up" data-i18n="partner.formSub">
        Fill in the form and our partnership team will get back to you within 24 hours.
      </p>
    </div>
    <form class={partnerForm} id="partnerForm" data-aos="fade-up" data-aos-delay="80">
      <div class="grid content-start gap-4">
        <label class={field}>
          <span data-i18n="partner.name">Your name</span>
          <input class={input} name="name" type="text" required />
        </label>
        <label class={field}>
          <span data-i18n="partner.email">E-mail</span>
          <input class={input} name="email" type="email" required />
        </label>
        <label class={field}>
          <span data-i18n="partner.phone">Phone (optional)</span>
          <input class={input} name="phone" type="tel" />
        </label>
        <label class={field}>
          <span data-i18n="partner.date">Preferred meeting date (optional)</span>
          <input class={input} name="date" type="date" />
        </label>
      </div>
      <div class="grid grid-rows-[auto_minmax(10rem,1fr)_auto] gap-4">
        <label class={field}>
          <span data-i18n="partner.category">Category</span>
          <select class={input} name="category" required>
            <option value="" data-i18n="partner.catPlaceholder">Select category</option>
            <option value="partnership" data-i18n="partner.catPartnership">Partnership</option>
            <option value="support" data-i18n="partner.catSupport">Support</option>
            <option value="press" data-i18n="partner.catPress">Press</option>
            <option value="other" data-i18n="partner.catOther">Other</option>
          </select>
        </label>
        <label class={`${field} min-h-0`}>
          <span data-i18n="partner.message">Message</span>
          <textarea class={`${input} h-full min-h-[10rem] resize-none`} name="message" rows="6" required></textarea>
        </label>
        <div class="grid gap-3">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <label class="flex min-w-0 flex-1 items-center gap-2.5 text-[13px] font-medium">
              <input class="size-[18px] min-h-[18px] shrink-0 accent-blue-dark shadow-none" name="terms" type="checkbox" required />
              <span data-i18n="partner.terms">I agree with the Terms & Conditions</span>
            </label>
            <button class={`${btnPrimary} shrink-0`} type="submit" data-i18n="partner.send">Send message</button>
          </div>
          <p class="text-sm font-semibold text-green-dark" id="partnerOk" hidden data-i18n="partner.success">
            Your message was sent! We’ll get back to you soon.
          </p>
        </div>
      </div>
    </form>
  </div>
</section>
