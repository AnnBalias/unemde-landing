---
import { shotImg } from "../../lib/ui";

interface Props {
  src: string;
  motion: "a" | "b" | "solo";
}

const { src, motion } = Astro.props;
const pos =
  motion === "solo"
    ? "top-[8%] right-[8%] left-auto z-20 w-[62%] max-sm:top-[6%] max-sm:left-1/2 max-sm:right-auto max-sm:w-[52%] max-sm:-translate-x-1/2"
    : motion === "a"
      ? "top-[2%] left-[4%] z-20 w-[58%] max-sm:top-[4%] max-sm:left-[6%] max-sm:w-[56%]"
      : "top-[16%] right-[2%] z-10 w-[58%] max-sm:top-[20%] max-sm:right-[4%] max-sm:w-[56%]";
const frame =
  motion === "solo"
    ? "rotate-[3deg] animate-float-solo max-sm:rotate-[2deg] motion-reduce:animate-none motion-reduce:rotate-[3deg]"
    : motion === "b"
      ? "rotate-[8deg] animate-float-b max-sm:rotate-[5deg] motion-reduce:animate-none motion-reduce:rotate-[8deg]"
      : "-rotate-6 animate-float-a max-sm:-rotate-[4deg] motion-reduce:animate-none motion-reduce:-rotate-6";
---

<div class={`phone-shot absolute ${pos}`}>
  <div
    class={`phone-shot-frame aspect-[9/19] w-full overflow-hidden border border-white/18 bg-[#101820] p-[3.6%] shadow-float ${frame}`}
  >
    <div class="phone-shot-screen h-full overflow-hidden bg-[#0e1728]">
      <img class={shotImg} src={src} alt="" />
    </div>
  </div>
</div>

<style>
  .phone-shot {
    container-type: inline-size;
  }

  .phone-shot-frame {
    border-radius: clamp(12px, 14cqi, 36px);
  }

  .phone-shot-screen {
    border-radius: clamp(8px, 10cqi, 28px);
  }
</style>
