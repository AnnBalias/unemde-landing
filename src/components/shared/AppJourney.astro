---
import {
  howCaption,
  howPad,
  howRoot,
  howScrim,
  howScroll,
  howShot,
  howShotInner,
  howStep,
  howText,
  shotImg,
} from "../../lib/ui";

export type JourneyStep = {
  t: string;
  p: string;
  shot: string;
  title: string;
  text: string;
};

interface Props {
  steps: JourneyStep[];
}

const { steps } = Astro.props;
const track = steps.length * 230;
---

<div class={howRoot}>
  <div class={howScroll} data-app-journey>
    <div class={`mx-auto mb-6 flex w-max ${howPad}`} style={`min-width: ${track}px`}>
      <ol
        class="m-0 grid list-none gap-5 p-0"
        style={`width: ${track}px; grid-template-columns: repeat(${steps.length}, minmax(0, 1fr))`}
      >
        {
          steps.map((s) => (
            <li>
              <article class={howStep} data-how-step tabindex="0">
                <div class={`${howShot} bottom-[calc(32%+0.625rem)]`}>
                  <div class={howShotInner}>
                    <img class={shotImg} src={s.shot} alt="" />
                  </div>
                </div>
                <div class={howScrim} aria-hidden="true" />
                <div class={`${howCaption} min-h-[32%] px-4 py-3.5`}>
                  <h3 class="text-base leading-tight font-bold" data-i18n={s.t}>
                    {s.title}
                  </h3>
                  <p class={`${howText} text-xs leading-[1.35]`} data-i18n={s.p}>
                    {s.text}
                  </p>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</div>
