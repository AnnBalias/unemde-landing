---
interface Props {
  src: string;
  motion: "a" | "b";
  aos?: string;
  delay?: number;
}

const { src, motion, aos = "fade-up", delay } = Astro.props;
const pos =
  motion === "a"
    ? "top-[2%] left-[4%] z-20 w-[58%] max-sm:top-[4%] max-sm:left-[6%] max-sm:w-[56%]"
    : "top-[16%] right-[2%] z-10 w-[58%] max-sm:top-[20%] max-sm:right-[4%] max-sm:w-[56%]";
const frame =
  motion === "a"
    ? "-rotate-6 animate-float-a max-sm:-rotate-[4deg] motion-reduce:animate-none motion-reduce:-rotate-6"
    : "rotate-[8deg] animate-float-b max-sm:rotate-[5deg] motion-reduce:animate-none motion-reduce:rotate-[8deg]";
---

<div class={`absolute ${pos}`} data-aos={aos} data-aos-delay={delay}>
  <div
    class={`aspect-[9/19] w-full rounded-[clamp(22px,7vw,36px)] border border-white/18 bg-[#101820] p-[3.6%] shadow-float ${frame}`}
  >
    <div class="h-full overflow-hidden rounded-[clamp(16px,5.5vw,28px)] bg-[#0e1728]">
      <img class="h-full w-full object-cover object-top" src={src} alt="" />
    </div>
  </div>
</div>
