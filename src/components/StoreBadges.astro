---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["mt-5 flex flex-wrap items-center justify-center gap-3", className]}>
  <a
    class="inline-flex h-12 shrink-0 overflow-hidden rounded-[8px] outline-offset-2 transition duration-200 hover:-translate-y-px hover:shadow-card focus-visible:outline-2 focus-visible:outline-blue-light"
    href="#download"
    data-i18n="guest.storeApp"
    data-i18n-attr="aria-label"
    aria-label="Download on the App Store"
  >
    <img class="h-12 w-auto" src="/imgs/app-store.jpg" alt="" />
  </a>
  <a
    class="inline-flex h-12 shrink-0 overflow-hidden rounded-[8px] outline-offset-2 transition duration-200 hover:-translate-y-px hover:shadow-card focus-visible:outline-2 focus-visible:outline-blue-light"
    href="#download"
    data-i18n="guest.storePlay"
    data-i18n-attr="aria-label"
    aria-label="Get it on Google Play"
  >
    <img class="h-12 w-auto" src="/imgs/google-play.jpg" alt="" />
  </a>
</div>
