---
import { storeBadge } from "../../lib/ui";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-3", className ?? "mt-5 justify-center"]}>
  <a
    class={storeBadge}
    href="#download"
    data-i18n="home.storeApp"
    data-i18n-attr="aria-label"
    aria-label="Download on the App Store"
  >
    <img class="h-12 w-auto" src="/imgs/app-store.jpg" alt="" />
  </a>
  <a
    class={storeBadge}
    href="#download"
    data-i18n="home.storePlay"
    data-i18n-attr="aria-label"
    aria-label="Get it on Google Play"
  >
    <img class="h-12 w-auto" src="/imgs/google-play.jpg" alt="" />
  </a>
</div>
