---
import {
  howCaption,
  howPad,
  howRoot,
  howScrim,
  howScroll,
  howShot,
  howShotInner,
  howStep,
  howText,
  shotImg,
} from "../../lib/ui";

const steps: {
  t: string;
  p: string;
  shot: string;
  title: string;
  text: string;
}[] = [
  {
    t: "how.h2t",
    p: "how.h2p",
    shot: "/imgs/unemde/u-mainpage-l.jpg",
    title: "Choose",
    text: "The guest finds the venue on the map or in the list and picks a deal that fits.",
  },
  {
    t: "how.h3t",
    p: "how.h3p",
    shot: "/imgs/unemde/u-restaurantpage-l.jpg",
    title: "Book",
    text: "A day and a time slot — the visit is planned, not a coupon for later.",
  },
  {
    t: "how.h4t",
    p: "how.h4p",
    shot: "/imgs/unemde/u-mydeals-l.jpg",
    title: "Arrive",
    text: "The guest shows up. The booking is ready to activate on-site.",
  },
  {
    t: "how.h6t",
    p: "how.h6p",
    shot: "/imgs/unemde/u-rating-l.jpg",
    title: "Enjoy",
    text: "The discount is applied. Dine in or takeaway — then save the venue for next time.",
  },
];
---

<div class={howRoot}>
  <!--
    w-max + min-w-full: when the track fits, it stays centered; when it
    overflows, the inner box grows with the cards so both edges are reachable.
    Horizontal padding lives on that inner box so shadows aren't clipped.
  -->
  <div class={howScroll}>
    <div class={`mb-8 flex w-max min-w-full justify-center ${howPad}`}>
      <div class="relative w-[868px] shrink-0">
        <ol class="m-0 grid list-none grid-cols-4 gap-4 p-0 sm:gap-5">
        {
          steps.map((s, i) => {
            const n = String(i + 1).padStart(2, "0");
            const last = i === steps.length - 1;
            return (
            <li class="flex flex-col items-center">
              <article
                class:list={[
                  howStep,
                  last && "ring-1 ring-green-light/30",
                ]}
                data-how-step
                tabindex="0"
              >
                {/* Phone frame — expands to full bleed on hover / focus / tap */}
                <div class={`${howShot} bottom-[calc(34%+0.625rem)]`}>
                  <div class={howShotInner}>
                    <img class={shotImg} src={s.shot} alt="" />
                  </div>
                </div>

                {/* Hover / focus scrim */}
                <div class={howScrim} aria-hidden="true" />

                {/* Caption: solid panel at rest → overlay when previewed */}
                <div class={`${howCaption} min-h-[34%] px-3 py-3`}>
                  <h3 class="text-[15px] leading-tight font-bold" data-i18n={s.t}>
                    {s.title}
                  </h3>
                  <p class={`${howText} text-[11px] leading-4`} data-i18n={s.p}>
                    {s.text}
                  </p>
                </div>
              </article>

              <div class="relative mt-3 flex w-full flex-col items-center">
                <span class="mb-2 h-3 w-px bg-border" aria-hidden="true" />
                <div
                  class:list={[
                    "relative z-10 grid size-10 place-items-center rounded-full border-4 border-white text-[12px] font-bold text-white shadow-card",
                    last ? "bg-green-light" : "bg-blue-light",
                  ]}
                >
                  {n}
                </div>
              </div>
            </li>
            );
          })
        }
      </ol>

      <div
        class="pointer-events-none absolute right-[calc(100%/8)] bottom-[20px] left-[calc(100%/8)] h-px bg-[linear-gradient(90deg,#1f3053_0%,#456bb9_55%,#359752_100%)]"
        aria-hidden="true"
      />
      </div>
    </div>
  </div>
</div>
