---
import { faqCard, faqItem } from "../../lib/ui";

interface Props {
  q: string;
  a: string;
  open?: boolean;
  cat?: string;
  alwaysOpen?: boolean;
}

const { q, a, open = false, cat, alwaysOpen = false } = Astro.props;
---

{
  alwaysOpen ? (
    <article class={faqCard}>
      <h3 class="text-base font-bold text-text" data-i18n={q}></h3>
      <p class="mt-3 text-sm leading-[21px] text-dark-gray" data-i18n={a}></p>
    </article>
  ) : (
    <article
      class={faqItem}
      data-faq-item
      data-cat={cat}
      data-open={open || undefined}
    >
      <button class="flex w-full items-center justify-between gap-3 text-left" type="button">
        <span class="text-base font-bold text-text" data-i18n={q} />
        <svg
          class="size-5 shrink-0 text-blue-dark transition-transform duration-200 group-data-[open]:rotate-180"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5 7.5 10 12.5 15 7.5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <p class="mt-3 hidden text-sm leading-[21px] text-dark-gray group-data-[open]:block" data-i18n={a} />
    </article>
  )
}
