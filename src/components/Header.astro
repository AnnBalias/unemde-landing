---
import { NAV_LINKS, type PageId } from "../i18n/config";
import { wrap } from "../lib/ui";
import LangSwitch from "./LangSwitch.astro";
import Logo from "./Logo.astro";

interface Props {
  page: PageId;
}

const { page } = Astro.props;
---

<header
  class="sticky top-0 z-50 h-[60px] overflow-visible border-b border-transparent bg-white/92 backdrop-blur-[12px] transition-[border-color,box-shadow] duration-200 [view-transition-name:site-nav] data-scrolled:border-border data-scrolled:shadow-card"
  id="nav"
  transition:persist="site-nav"
>
  <div class={`${wrap} flex h-full items-center justify-between gap-4`}>
    <div class="flex min-w-0 items-center gap-6">
      <a class="flex shrink-0 items-center gap-2.5" href="/" aria-label="UNEMDE">
        <Logo gradId="navGrad" />
      </a>
      <nav
        class="flex items-center gap-[18px] text-[13px] font-semibold text-dark-gray max-nav:hidden max-nav:data-open:absolute max-nav:data-open:top-full max-nav:data-open:right-4 max-nav:data-open:left-4 max-nav:data-open:mt-2 max-nav:data-open:flex max-nav:data-open:flex-col max-nav:data-open:gap-1 max-nav:data-open:rounded-[20px] max-nav:data-open:border max-nav:data-open:border-border max-nav:data-open:bg-white/96 max-nav:data-open:p-2 max-nav:data-open:shadow-float max-nav:data-open:backdrop-blur-xl"
        id="navLinks"
      >
      {
        NAV_LINKS.map((item) => (
          <a
            class="relative hover:text-blue-dark aria-[current=page]:text-blue-dark aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-2 aria-[current=page]:after:h-0.5 aria-[current=page]:after:rounded-sm aria-[current=page]:after:bg-brand max-nav:w-full max-nav:rounded-2xl max-nav:px-4 max-nav:py-3 max-nav:hover:bg-blue-soft max-nav:hover:text-blue-dark max-nav:aria-[current=page]:bg-brand max-nav:aria-[current=page]:text-white max-nav:aria-[current=page]:after:hidden"
            href={item.href}
            aria-current={page === item.page ? "page" : undefined}
            data-i18n={item.key}
          >
            {item.label}
          </a>
        ))
      }
      <a
        class="mt-1 hidden h-11 w-full items-center justify-center rounded-btn bg-green-grad px-4 text-[13px] font-semibold text-white shadow-card max-sm:flex"
        href="#stores"
        data-i18n="nav.cta"
      >
        Get the app
      </a>
    </nav>
    </div>
    <div class="flex items-center gap-2.5">
      <LangSwitch />
      <a
        class="inline-flex h-9 items-center justify-center rounded-btn bg-green-grad px-4 text-[13px] font-medium text-white shadow-card transition duration-200 hover:-translate-y-px max-sm:hidden"
        href="#stores"
        data-i18n="nav.cta"
      >
        Get the app
      </a>
      <button
        class="group hidden size-9 flex-col items-center justify-center gap-[5px] rounded-full border border-border bg-bg-soft max-nav:flex"
        id="menuBtn"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="navLinks"
      >
        <span class="block h-0.5 w-4 rounded-sm bg-blue-dark transition duration-200 group-aria-expanded:translate-y-[7px] group-aria-expanded:rotate-45"></span>
        <span class="block h-0.5 w-4 rounded-sm bg-blue-dark transition duration-200 group-aria-expanded:opacity-0"></span>
        <span class="block h-0.5 w-4 rounded-sm bg-blue-dark transition duration-200 group-aria-expanded:-translate-y-[7px] group-aria-expanded:-rotate-45"></span>
      </button>
    </div>
  </div>
</header>
